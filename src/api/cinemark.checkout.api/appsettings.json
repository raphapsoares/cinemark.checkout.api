{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "DatabasePath": "../../../database/cinemark.db",
    "BusyTimeoutMs": 5000
  },
  "PaymentResilience": {
    "TotalRequestTimeout": { "Timeout": "00:00:15" },
    "AttemptTimeout": { "Timeout": "00:00:02" },
    "Retry": {
      "MaxRetryAttempts": 3,
      "BackoffType": "Exponential",
      "UseJitter": true,
      "Delay": "00:00:00.200"
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 4,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:30"
    }
  },
  "FakePayment": {
    "FailureRate": 0.1,
    "DeclineRate": 0.1,
    "MinDelayMs": 50,
    "MaxDelayMs": 300
  }
}
